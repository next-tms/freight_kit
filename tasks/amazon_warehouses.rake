require 'json'

namespace :amazon_warehouses do
  desc 'Fetch Amazon warehouse locations from OpenStreetMap into configuration/locations/amazon_warehouses.yml'
  task(update: :environment) do
    overpass_url = 'https://overpass-api.de/api/interpreter'
    path = File.expand_path('../configuration/locations/amazon_warehouses.yml', __dir__)

    query = <<~OVERPASS
      [out:json][timeout:180];
      area["ISO3166-1"="US"][admin_level=2]->.us;
      (
        nwr["operator"~"^amazon",i](area.us);
        nwr["brand:wikidata"="Q3884"](area.us);
        nwr["operator:wikidata"="Q3884"](area.us);
      );
      out center tags;
    OVERPASS

    attempts = 0

    begin
      attempts += 1
      response = HTTPX
                 .with(headers: { 'user-agent' => FreightKit::HTTPClient::USER_AGENT }, timeout: { read_timeout: 240 })
                 .post(overpass_url, form: { data: query })
      response.raise_for_status
    rescue StandardError => e
      raise if attempts >= 3

      puts "#{e.message}, retrying in 60 seconds"
      sleep(60)
      retry
    end

    warehouse_types = ['distribution', 'industrial', 'logistics', 'warehouse']

    warehouses = JSON.parse(response.body.to_s)['elements'].filter_map do |element|
      tags = element['tags'] || {}
      next unless tags.values_at('building', 'industrial', 'landuse').intersect?(warehouse_types)
      next if tags['telecom'].present? || "#{tags['name']} #{tags['operator']}".match?(/\b(aws|web services)\b/i)

      ref = tags['ref'].presence || tags['name']&.[](/\b[A-Z]{3}\d{1,2}\b/)
      next if tags['name'].present? && ref.blank? && !tags['name'].match?(/amazon/i)

      address1 = [tags['addr:housenumber'], tags['addr:street']].compact.join(' ').presence
      center = element['center'] || element

      {
        osm_id: "#{element['type']}/#{element['id']}",
        ref:,
        name: tags['name'],
        address1:,
        street_key: FreightKit::AddressNormalizer.street_key(address1),
        city: tags['addr:city'],
        province: tags['addr:state'],
        postal_code: tags['addr:postcode']&.[](/\A\d{5}/),
        lat: center['lat'],
        lng: center['lon']
      }.compact
    end

    warehouses.sort_by! { |warehouse| warehouse.values_at(:province, :postal_code, :osm_id).map(&:to_s) }

    previous_count = File.exist?(path) ? FreightKit::AmazonWarehouse.all.size : 0
    if warehouses.size < previous_count * 0.9 && ENV['FORCE'].blank?
      raise "Fetched #{warehouses.size} warehouses, down from #{previous_count}. " \
            'Set FORCE=1 to write the file anyway.'
    end

    mkdir_p(File.dirname(path))
    File.write(path, <<~YAML + warehouses.to_yaml.delete_prefix("---\n"))
      # Amazon warehouses in the United States.
      #
      # Data © OpenStreetMap contributors, available under the Open Database License (ODbL).
      # https://www.openstreetmap.org/copyright
      #
      # Generated by `rake amazon_warehouses:update`. Do not edit by hand.
    YAML

    puts "Wrote #{warehouses.size} warehouses to #{path}"
  end
end
